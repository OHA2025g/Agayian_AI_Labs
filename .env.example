# Resend API key from https://resend.com
RESEND_API_KEY=

# Inbox that receives contact and newsletter notifications
CONTACT_TO_EMAIL=hello@agrayian.ai

# Verified sender (use onboarding@resend.dev for testing, or your domain)
CONTACT_FROM_EMAIL=Agrayian AI Labs <onboarding@resend.dev>

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# REQUIRED in production — forms fail closed without TURNSTILE_SECRET_KEY
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for distributed rate limiting
# REQUIRED for multi-instance production (in-memory is per-instance only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payload CMS + MongoDB
PAYLOAD_SECRET=replace-with-a-long-random-string
# Local Docker Compose default:
DATABASE_URI=mongodb://127.0.0.1:27017/agrayian
# EasyPanel / compose service name example:
# DATABASE_URI=mongodb://mongo:27017/agrayian
# With auth:
# DATABASE_URI=mongodb://agrayian:CHANGE_ME@mongo:27017/agrayian?authSource=admin
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First admin user for seed (optional). Signs in at /admin.
# Native Payload UI is at /cms and is super_admin only.
ADMIN_EMAIL=admin@agrayian.ai
ADMIN_PASSWORD=ChangeMeNow!123

# Preview secret for draft preview routes
PREVIEW_SECRET=replace-with-preview-secret

# Secured cron for scheduled publish (`/api/cron/publish-scheduled`)
CRON_SECRET=replace-with-cron-secret

# S3-compatible media (production). Leave unset to use local /media in development.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
